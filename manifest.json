{
  "manifest_version": 3,

  "name": "RepoScan AI",

  "version": "10.0.0",

  "description": "AI-powered GitHub repository scanner, smart code reviewer, README generator, commit helper and developer productivity extension.",

  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],

  "host_permissions": [
    "https://github.com/*",
    "https://api.github.com/*",
    "http://localhost:3000/*",
    "https://*.onrender.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://github.com/*/*",
        "https://github.com/*/*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "RepoScan AI",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "content.css",
        "icons/*"
      ],
      "matches": [
        "https://github.com/*"
      ]
    }
  ]
}